{
  "uid": "deepquery",
  "title": "deepquery",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求速率（按状态）",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (status) (rate(deepquery_requests_total[1m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "端到端延迟 P50 / P95",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(deepquery_request_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(deepquery_request_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Token 消耗速率",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(deepquery_llm_tokens_total[5m])", "legendFormat": "tokens/s" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "累计成本",
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "deepquery_llm_cost_total" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "缓存命中",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "deepquery_cache_hits_total" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "防幻觉拦截",
      "gridPos": { "x": 16, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "deepquery_hallucination_blocked_total" }]
    }
  ]
}
